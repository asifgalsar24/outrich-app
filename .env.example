# ── Telegram ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather

# ── Supabase ───────────────────────────────────────────────
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...   # Project Settings → API → service_role

# ── Claude (Anthropic) ────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── OpenRouter (for Perplexity research) ──────────────────
OPENROUTER_API_KEY=sk-or-...

# ── Lemlist ───────────────────────────────────────────────
LEMLIST_API_KEY=your_lemlist_api_key
LEMLIST_CAMPAIGN_ID=cam_your_campaign_id

# ── Meta Ads Library ──────────────────────────────────────
META_ACCESS_TOKEN=your_meta_access_token

# ── Hunter.io (email finder) — optional ───────────────────
# HUNTER_API_KEY=your_hunter_key

# ── CORS (set to Vercel URL in production) ────────────────
ALLOWED_ORIGIN=https://your-app.vercel.app

# ── Playwright (set automatically by Dockerfile on Railway) ─
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
